# Образец файла .env. Скопируйте его в .env и подставьте свои значения:
#     cp .env.example .env
# Сам .env в git не попадает (см. .gitignore) — в нём секреты.

# --- Бот ---
# Токен от @BotFather.
BOT_TOKEN=123456:replace-me
# Адрес API, к которому обращается бот.
API_BASE_URL=http://127.0.0.1:8000
# Необязательно: прокси для доступа к Telegram, например http://127.0.0.1:10809
TELEGRAM_PROXY=
# Необязательно: тот же прокси, но для бота в Docker. Из контейнера
# компьютер виден как host.docker.internal, например
# http://host.docker.internal:10809. На сервере не нужен.
DOCKER_TELEGRAM_PROXY=

# --- Ключ API ---
# Общий секрет бота и API: бот шлёт его в заголовке X-API-Key, API без
# него отвечает 401. Без API_KEY не запустится ни API, ни бот.
# Сгенерировать: py -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- База данных ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=tgbot
# Таблицы создаются в схеме tgbot (см. schema_v2.sql).
POSTGRES_SCHEMA=tgbot
POSTGRES_USER=tgbot
POSTGRES_PASSWORD=replace-me
